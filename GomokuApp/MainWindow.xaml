<Window x:Class="GomokuApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="五子棋对战"
        Width="1180"
        Height="760"
        MinWidth="1080"
        MinHeight="720"
        Background="#F4EFE7"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="680" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="20"
                Background="#F8F3EB"
                CornerRadius="28"
                BorderBrush="#DDC9AA"
                BorderThickness="1.5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#2C241A"
                               Text="五子棋" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="14"
                               Foreground="#6B5B45"
                               Text="支持从空局开始对战，也支持手动摆残局后指定 AI 执黑或执白继续下。" />
                </StackPanel>

                <Viewbox Grid.Row="1" Stretch="Uniform">
                    <Border Padding="18"
                            Background="#EBC37A"
                            CornerRadius="18"
                            BorderBrush="#C79746"
                            BorderThickness="1.5"
                            SnapsToDevicePixels="True">
                        <Canvas x:Name="BoardCanvas"
                                Width="580"
                                Height="580"
                                Background="#E6BE74"
                                MouseLeftButtonDown="BoardCanvas_OnMouseLeftButtonDown" />
                    </Border>
                </Viewbox>

                <Border Grid.Row="2"
                        Margin="0,18,0,0"
                        Padding="14,12"
                        Background="#FFF9EF"
                        CornerRadius="16"
                        BorderBrush="#E5D2B3"
                        BorderThickness="1">
                    <TextBlock x:Name="StatusTextBlock"
                               FontSize="15"
                               Foreground="#3F3427"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Padding="22"
                Background="#1F2A2C"
                CornerRadius="28">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#F6F0E5"
                               Text="控制台" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="13"
                               Foreground="#B8C5BE"
                               Text="首版为自由规则。大师模式会更慢一些，但会做更深的防守和进攻搜索。" />

                    <Border Margin="0,22,0,0"
                            Padding="18"
                            Background="#263638"
                            CornerRadius="20">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#F8F3EB"
                                       Text="标准对战" />
                            <TextBlock Margin="0,12,0,0"
                                       Foreground="#BFD0CA"
                                       Text="AI 难度" />
                            <ComboBox x:Name="DifficultyCombo"
                                      Margin="0,8,0,0"
                                      SelectionChanged="DifficultyCombo_OnSelectionChanged">
                                <ComboBoxItem Tag="Easy">简单</ComboBoxItem>
                                <ComboBoxItem Tag="Normal">普通</ComboBoxItem>
                                <ComboBoxItem Tag="Hard">困难</ComboBoxItem>
                                <ComboBoxItem Tag="Master">大师</ComboBoxItem>
                            </ComboBox>

                            <Button Margin="0,16,0,0"
                                    Padding="12,10"
                                    Click="NewPlayerFirstButton_OnClick"
                                    Content="从空局开始：你执黑先手" />
                            <Button Margin="0,10,0,0"
                                    Padding="12,10"
                                    Click="NewAiFirstButton_OnClick"
                                    Content="AI 先手" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="UndoButton"
                                        Grid.Column="0"
                                        Padding="12,10"
                                        Click="UndoButton_OnClick"
                                        Content="悔棋" />
                                <Button x:Name="RestartButton"
                                        Grid.Column="2"
                                        Padding="12,10"
                                        Click="RestartButton_OnClick"
                                        Content="重新开始" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,18,0,0"
                            Padding="18"
                            Background="#304447"
                            CornerRadius="20">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#F8F3EB"
                                       Text="残局编辑" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#C7D7D1"
                                       Text="进入编辑模式后，点击棋盘摆子；选择“空位”时点击即可删除棋子。" />

                            <Button Margin="0,16,0,0"
                                    Padding="12,10"
                                    Click="EnterSetupModeButton_OnClick"
                                    Content="进入残局编辑模式" />
                            <Button Margin="0,10,0,0"
                                    Padding="12,10"
                                    Click="ClearBoardButton_OnClick"
                                    Content="清空棋盘" />

                            <TextBlock Margin="0,16,0,0"
                                       Foreground="#C7D7D1"
                                       Text="点击棋盘时放置" />
                            <ComboBox x:Name="EditStoneCombo"
                                      Margin="0,8,0,0">
                                <ComboBoxItem Tag="Black">黑子</ComboBoxItem>
                                <ComboBoxItem Tag="White">白子</ComboBoxItem>
                                <ComboBoxItem Tag="None">空位</ComboBoxItem>
                            </ComboBox>

                            <TextBlock Margin="0,16,0,0"
                                       Foreground="#C7D7D1"
                                       Text="从当前局面开始时，下一手方" />
                            <ComboBox x:Name="NextTurnCombo"
                                      Margin="0,8,0,0">
                                <ComboBoxItem Tag="Black">黑方</ComboBoxItem>
                                <ComboBoxItem Tag="White">白方</ComboBoxItem>
                            </ComboBox>

                            <TextBlock Margin="0,16,0,0"
                                       Foreground="#C7D7D1"
                                       Text="从当前局面开始时，AI 执方" />
                            <ComboBox x:Name="SetupAiSideCombo"
                                      Margin="0,8,0,0">
                                <ComboBoxItem Tag="Black">黑方</ComboBoxItem>
                                <ComboBoxItem Tag="White">白方</ComboBoxItem>
                            </ComboBox>

                            <Button Margin="0,18,0,0"
                                    Padding="12,10"
                                    Click="StartFromPositionButton_OnClick"
                                    Content="从当前残局开始对战" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
